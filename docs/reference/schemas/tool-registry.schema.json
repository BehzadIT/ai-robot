{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": 1},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "category", "manufacturer", "model", "availability",
          "condition", "owner_familiarity", "capabilities", "limitations",
          "accessories", "safety_requirements", "suitable_robot_tasks",
          "unsuitable_tasks", "provenance", "question_ids"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^tool-[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["measurement", "electronics-assembly", "fabrication", "hand-tool", "safety", "software-interface", "workholding"]
          },
          "manufacturer": {"type": ["string", "null"]},
          "model": {"type": ["string", "null"]},
          "availability": {"enum": ["available", "incomplete", "needs-consumable", "unavailable", "unknown"]},
          "condition": {"enum": ["working", "needs-check", "damaged", "unknown"]},
          "owner_familiarity": {"enum": ["expert", "comfortable", "learning", "new", "unknown"]},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "ranges_and_accuracy": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "compatible_materials": {"type": "array", "items": {"type": "string"}},
          "accessories": {"type": "array", "items": {"type": "string"}},
          "safety_requirements": {"type": "array", "items": {"type": "string"}},
          "suitable_robot_tasks": {"type": "array", "items": {"type": "string"}},
          "unsuitable_tasks": {"type": "array", "items": {"type": "string"}},
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {"type": "string", "pattern": "^source-[a-z0-9-]+$"},
                "locator": {"type": "string", "minLength": 1},
                "owner_report": {"type": "string", "minLength": 1},
                "evidence_id": {"type": "string", "pattern": "^EV-[0-9]{4}-[0-9]{3}$"}
              },
              "anyOf": [
                {"required": ["source_id", "locator"]},
                {"required": ["owner_report"]},
                {"required": ["evidence_id"]}
              ]
            }
          },
          "question_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^Q-US002-[0-9]{3}$"}
          },
          "dossier": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
