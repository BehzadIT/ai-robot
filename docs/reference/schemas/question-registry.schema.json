{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "batch", "suspected_item", "known_context", "question", "reason", "impact", "preferred_evidence", "acceptable_fallback", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q-US002-[0-9]{3}$"},
          "batch": {"type": "string", "pattern": "^[A-E][0-9]?$"},
          "suspected_item": {"type": "string"},
          "known_context": {"type": "string"},
          "question": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "impact": {"type": "array", "minItems": 1, "items": {"enum": ["safety", "compatibility", "procedure", "documentation"]}},
          "preferred_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "acceptable_fallback": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^source-[a-z0-9-]+$"}},
          "status": {"enum": ["open", "answered-owner-reported", "evidence-pending", "closed", "blocked", "deferred"]},
          "resolution": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV-[0-9]{4}-[0-9]{3}$"}}
        }
      }
    }
  }
}
