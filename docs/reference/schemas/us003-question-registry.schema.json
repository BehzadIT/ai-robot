{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "us003-question-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observed", "question", "reason", "requested_action", "expected_after_action", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q-US003-[0-9]{3}$"},
          "observed": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "requested_action": {"type": "string", "minLength": 1},
          "expected_after_action": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "answered-owner-reported", "evidence-pending", "closed", "blocked", "deferred"]},
          "resolution": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV-[0-9]{4}-[0-9]{3}$"}}
        }
      }
    }
  }
}
