{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "path", "sha256", "authority", "extraction_status", "applicability"],
        "properties": {
          "id": {"type": "string", "pattern": "^source-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "kind": {"enum": ["vendor-manual", "project-note", "project-pdf", "photo", "data", "code"]},
          "path": {"type": "string", "pattern": "^(docs|robot-(pico|esp32|android)-platform|robot-android-app)/"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "manufacturer": {"type": ["string", "null"]},
          "model_scope": {"type": ["string", "null"]},
          "revision": {"type": ["string", "null"]},
          "authority": {"enum": ["vendor", "code-backed", "owner-project-note", "generated-project-note", "unknown"]},
          "extraction_status": {"enum": ["not-extracted", "text-reviewed", "render-reviewed", "ocr-unverified"]},
          "applicability": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
